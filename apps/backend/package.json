{
  "name": "@email-cms/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npx tsx --conditions development src/index.ts",
    "worker": "npx tsx --conditions development src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:start": "node dist/worker/index.js",
    "test": "vitest --run --config vitest.config.ts"
  },
  "imports": {
    "#/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#shared/*": {
      "types": "../../packages/shared/src/*.ts",
      "development": "../../packages/shared/src/*.ts",
      "default": "../../packages/shared/dist/*.js"
    }
  }
}
