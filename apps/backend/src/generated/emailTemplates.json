{
  "/templates/email/smz-school-news/blocks/about.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#fefcfa;background-image:linear-gradient(180deg,#fdf9f6 0%,#fefdfb 120px,#fefdfb 100%);\">\n  <tr>\n    <td style=\"padding:26px 36px 6px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td valign=\"middle\">\n            <!-- \"About us\" script sliced from the design -->\n            <img src=\"{{> assetAboutTitle}}\" width=\"200\" height=\"64\" alt=\"{{aboutTitleEn}}\" style=\"display:inline-block;vertical-align:middle;width:200px;height:64px;border:0;font-family:'Snell Roundhand','Brush Script MT','Segoe Script',cursive;font-size:32px;color:#9c7c65;\" />\n            <span style=\"display:inline-block;margin-left:10px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:18px;line-height:1.2;font-weight:700;letter-spacing:4px;color:#4a4039;vertical-align:middle;\">{{aboutTitleZh}}</span>\n          </td>\n          <td valign=\"middle\" align=\"right\" style=\"text-align:right;\">\n            <img src=\"{{> assetSwatches}}\" width=\"96\" height=\"26\" alt=\"\" style=\"display:inline-block;width:96px;height:26px;border:0;\" />\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:12px 36px 30px;font-size:0;line-height:0;text-align:left;\">\n      {{#if aboutImageUrl}}\n      <!-- Fluid columns: portrait left, mission panel right; stacked on narrow screens -->\n      <div style=\"display:inline-block;width:100%;max-width:268px;vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding:0 18px 14px 0;\">\n              <img src=\"{{aboutImageUrl}}\" width=\"250\" alt=\"{{aboutTitleZh}}\" style=\"display:block;width:100%;max-width:250px;height:auto;border:0;border-radius:46% 42% 48% 40% / 42% 48% 40% 46%;background-color:#f1ddd2;\" />\n            </td>\n          </tr>\n        </table>\n      </div>\n      {{/if}}\n      <div style=\"display:inline-block;width:100%;max-width:{{#if aboutImageUrl}}300px{{else}}568px{{/if}};vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f0e5de;background-image:linear-gradient(180deg,#f3e8e1 0%,#ecdfd7 100%);border-radius:22px 30px 22px 26px;\">\n          <tr>\n            <td style=\"padding:22px 24px 20px;\">\n              <div style=\"font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.9;color:#5c4e45;\">{{schoolMission}}</div>\n              {{#if aboutUrl}}\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:16px;\">\n                <tr>\n                  <td align=\"center\" style=\"text-align:center;\">\n                    {{> ctaButton url=aboutUrl label=aboutCtaLabel align=\"center\"}}\n                  </td>\n                </tr>\n              </table>\n              {{/if}}\n            </td>\n          </tr>\n        </table>\n      </div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/class-article.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;background-image:linear-gradient(180deg,#fdf5f1 0%,#ffffff 22%,#ffffff 78%,#fdf5f1 100%);\">\n  <tr>\n    <td style=\"padding:22px 36px 26px;font-size:0;line-height:0;text-align:left;\">\n      <!-- Fluid columns: side by side on desktop, stacked on narrow screens -->\n      <div style=\"display:inline-block;width:100%;max-width:232px;vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding:0 22px 12px 0;\">\n              <img src=\"{{article.image_url}}\" width=\"210\" alt=\"{{article.title}}\" style=\"display:block;width:100%;max-width:210px;height:auto;border:0;border-radius:18px;background-color:#f1ddd2;\" />\n            </td>\n          </tr>\n        </table>\n      </div>\n      <div style=\"display:inline-block;width:100%;max-width:336px;vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding:0 0 12px;\">\n              <h2 style=\"margin:0;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:24px;line-height:1.3;font-weight:700;letter-spacing:2px;color:#4a4039;\">{{article.title}}</h2>\n              <div style=\"margin-top:4px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:1px;text-transform:uppercase;color:#9a8a7f;\">{{eyebrow}} · {{class.name}}</div>\n              <div style=\"margin-top:8px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;\">{{article.excerpt}}</div>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:14px;\">\n                <tr>\n                  <td align=\"right\" style=\"text-align:right;\">\n                    {{> ctaButton url=article.url label=ctaLabel align=\"right\"}}\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/custom-html.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td style=\"padding:12px 36px 6px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;\">\n      {{{html.communityAnnouncement}}}\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/footer.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td style=\"padding:6px 36px 0;font-size:0;line-height:0;\">\n      <!-- Rainbow dashed rule sliced from the design -->\n      <img src=\"{{> assetRule}}\" width=\"568\" height=\"16\" alt=\"\" style=\"display:block;width:100%;max-width:568px;height:auto;border:0;\" />\n    </td>\n  </tr>\n  <tr>\n    <td align=\"center\" style=\"padding:22px 36px 0;text-align:center;\">\n      <div style=\"font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:19px;line-height:1.3;font-weight:700;letter-spacing:3px;color:#4a4039;\">{{schoolName}}</div>\n      <div style=\"margin-top:12px;font-family:Arial,Helvetica,'Noto Sans TC','PingFang TC',sans-serif;font-size:14px;line-height:1.6;letter-spacing:1px;color:#b89467;\"><span style=\"display:inline-block;padding:0 12px;white-space:nowrap;\">TEL : {{tel}}</span><span style=\"display:inline-block;padding:0 12px;white-space:nowrap;\">FAX : {{fax}}</span></div>\n      <div style=\"margin-top:4px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;letter-spacing:1px;color:#b89467;\">地址：{{address}}</div>\n    </td>\n  </tr>\n  <tr>\n    <td align=\"center\" style=\"padding:18px 36px 34px;text-align:center;\">\n      <!-- Social icons sliced from the design; each renders only when its destination is configured -->\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto;\">\n        <tr>\n          {{#if facebookUrl}}\n          <td style=\"padding:0 14px;\">\n            <a href=\"{{facebookUrl}}\" title=\"{{facebookLabel}}\" style=\"display:block;text-decoration:none;\"><img src=\"{{> assetIconFacebook}}\" width=\"44\" height=\"44\" alt=\"Facebook\" style=\"display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;\" /></a>\n          </td>\n          {{/if}}\n          {{#if instagramUrl}}\n          <td style=\"padding:0 14px;\">\n            <a href=\"{{instagramUrl}}\" title=\"Instagram\" style=\"display:block;text-decoration:none;\"><img src=\"{{> assetIconInstagram}}\" width=\"44\" height=\"44\" alt=\"Instagram\" style=\"display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;\" /></a>\n          </td>\n          {{/if}}\n          {{#if contactEmail}}\n          <td style=\"padding:0 14px;\">\n            <a href=\"mailto:{{contactEmail}}\" title=\"{{contactEmail}}\" style=\"display:block;text-decoration:none;\"><img src=\"{{> assetIconEmail}}\" width=\"44\" height=\"44\" alt=\"Email\" style=\"display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;\" /></a>\n          </td>\n          {{/if}}\n          {{#if websiteUrl}}\n          <td style=\"padding:0 14px;\">\n            <a href=\"{{websiteUrl}}\" title=\"{{websiteUrl}}\" style=\"display:block;text-decoration:none;\"><img src=\"{{> assetIconWebsite}}\" width=\"44\" height=\"44\" alt=\"Website\" style=\"display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;\" /></a>\n          </td>\n          {{/if}}\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/header.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td style=\"padding:0;font-size:0;line-height:0;\">\n      <!-- Masthead sliced from the design: watercolor logo, hand-lettered brand name and \"SMZ School News\" script -->\n      <img src=\"{{> assetHeaderBanner}}\" width=\"640\" height=\"168\" alt=\"{{brandName}} — {{scriptTitle}}\" style=\"display:block;width:100%;max-width:640px;height:auto;border:0;font-family:'Snell Roundhand','Brush Script MT','Segoe Script',cursive;font-size:32px;line-height:168px;text-align:center;color:#e0a3b1;\" />\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:0;font-size:0;line-height:0;\">\n      <div style=\"height:20px;background-color:#f9ece6;background-image:linear-gradient(180deg,#ffffff 0%,#f6e2d9 100%);\">&nbsp;</div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/read-more-cta.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td align=\"center\" style=\"padding:22px 36px 34px;text-align:center;\">\n      {{> ctaButton url=newsletter.url label=ctaLabel align=\"center\"}}\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:0;font-size:0;line-height:0;\">\n      <div style=\"height:16px;background-color:#f8ebe4;background-image:linear-gradient(180deg,#f6e2d9 0%,#ffffff 100%);\">&nbsp;</div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/shared-article.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f9ece5;background-image:linear-gradient(90deg,#f5dfd6 0%,#f9ebe4 55%,#fdf6f2 100%);\">\n  <tr>\n    <td style=\"padding:22px 36px 26px;font-size:0;line-height:0;text-align:left;\">\n      <!-- Fluid columns: side by side on desktop, stacked on narrow screens -->\n      <div style=\"display:inline-block;width:100%;max-width:232px;vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding:0 22px 12px 0;\">\n              <img src=\"{{article.image_url}}\" width=\"210\" alt=\"{{article.title}}\" style=\"display:block;width:100%;max-width:210px;height:auto;border:0;border-radius:18px;background-color:#f1ddd2;\" />\n            </td>\n          </tr>\n        </table>\n      </div>\n      <div style=\"display:inline-block;width:100%;max-width:336px;vertical-align:middle;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr>\n            <td style=\"padding:0 0 12px;\">\n              <h2 style=\"margin:0;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:24px;line-height:1.3;font-weight:700;letter-spacing:2px;color:#4a4039;\">{{article.title}}</h2>\n              <div style=\"margin-top:4px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:1px;text-transform:uppercase;color:#9a8a7f;\">{{eyebrow}}</div>\n              <div style=\"margin-top:8px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;\">{{article.excerpt}}</div>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:14px;\">\n                <tr>\n                  <td align=\"right\" style=\"text-align:right;\">\n                    {{> ctaButton url=article.url label=ctaLabel align=\"right\"}}\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/weekly-divider.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td style=\"padding:22px 0 8px;\">\n      <!-- Watercolor banner sliced from the design: pink brush stroke (本週重要事情佈達), blue wash + script (The weekly news) -->\n      <img src=\"{{> assetWeeklyBanner}}\" width=\"640\" height=\"148\" alt=\"{{scriptTitle}} — {{sectionTitle}}\" style=\"display:block;width:100%;max-width:640px;height:auto;border:0;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:20px;font-weight:700;color:#9c7c65;\" />\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/blocks/weekly-item.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n  <tr>\n    <td style=\"padding:10px 36px 8px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td width=\"18\" valign=\"top\" style=\"width:18px;padding-top:7px;\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td width=\"9\" height=\"9\" style=\"width:9px;height:9px;border-radius:50%;background-color:#df97a7;font-size:0;line-height:0;\">&nbsp;</td>\n              </tr>\n            </table>\n          </td>\n          <td valign=\"top\" style=\"padding-left:6px;\">\n            <a href=\"{{article.url}}\" style=\"font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:16px;line-height:1.35;font-weight:700;color:#4a4039;text-decoration:underline;\">{{article.title}}</a>\n            <div style=\"margin-top:3px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:0.5px;color:#b9a48f;\">{{article.date}}</div>\n            <div style=\"margin-top:6px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;\">{{article.excerpt}} <a href=\"{{article.url}}\" style=\"color:#6e6057;text-decoration:none;\">{{readMoreLabel}}</a></div>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/metadata.json": "{\n  \"sourceId\": \"smz-school-news\",\n  \"name\": \"SMZ School News\",\n  \"description\": \"Watercolor-style weekly newsletter matching the SMZ School News design: featured school cards, per-class news cards, the weekly announcement list (本週重要事情佈達), an About us panel and the contact footer. Decorative artwork (logo, script titles, watercolor banner, rainbow rule, social icons) is sliced from the design and served from https://smz-email-assets.pages.dev (see scripts/email-assets-deploy.mjs).\",\n  \"version\": \"1.3.0\",\n  \"subject\": \"subject.hbs\",\n  \"partials\": [\n    {\n      \"name\": \"ctaButton\",\n      \"file\": \"partials/cta-button.hbs\"\n    },\n    {\n      \"name\": \"assetHeaderBanner\",\n      \"file\": \"partials/assets/header-banner.hbs\"\n    },\n    {\n      \"name\": \"assetWeeklyBanner\",\n      \"file\": \"partials/assets/weekly-banner.hbs\"\n    },\n    {\n      \"name\": \"assetAboutTitle\",\n      \"file\": \"partials/assets/about-title.hbs\"\n    },\n    {\n      \"name\": \"assetSwatches\",\n      \"file\": \"partials/assets/swatches.hbs\"\n    },\n    {\n      \"name\": \"assetRule\",\n      \"file\": \"partials/assets/rule.hbs\"\n    },\n    {\n      \"name\": \"assetIconFacebook\",\n      \"file\": \"partials/assets/icon-facebook.hbs\"\n    },\n    {\n      \"name\": \"assetIconInstagram\",\n      \"file\": \"partials/assets/icon-instagram.hbs\"\n    },\n    {\n      \"name\": \"assetIconEmail\",\n      \"file\": \"partials/assets/icon-email.hbs\"\n    },\n    {\n      \"name\": \"assetIconWebsite\",\n      \"file\": \"partials/assets/icon-website.hbs\"\n    }\n  ],\n  \"blocks\": [\n    {\n      \"id\": \"header\",\n      \"mode\": \"static\",\n      \"type\": \"header\",\n      \"label\": \"Header / masthead\",\n      \"file\": \"blocks/header.hbs\",\n      \"order\": 0,\n      \"config\": {\n        \"brandName\": \"善美真華德福教育\",\n        \"scriptTitle\": \"SMZ School News\"\n      }\n    },\n    {\n      \"id\": \"featured-school-articles\",\n      \"mode\": \"article-repeat\",\n      \"type\": \"shared-article-feature\",\n      \"label\": \"Featured school articles\",\n      \"file\": \"blocks/shared-article.hbs\",\n      \"order\": 1,\n      \"articleSource\": \"sharedArticles\",\n      \"config\": {\n        \"eyebrow\": \"REGARDING SCHOOL\",\n        \"ctaLabel\": \"READ MORE\",\n        \"maxItems\": 3,\n        \"excerptLength\": 84,\n        \"excludeSourceTag\": \"weekly\"\n      }\n    },\n    {\n      \"id\": \"class-news\",\n      \"mode\": \"class-article-repeat\",\n      \"type\": \"class-article-feature\",\n      \"label\": \"Class news & events\",\n      \"file\": \"blocks/class-article.hbs\",\n      \"order\": 2,\n      \"config\": {\n        \"eyebrow\": \"CLASS NEWS & EVENTS\",\n        \"ctaLabel\": \"READ MORE\",\n        \"maxItemsPerClass\": 2,\n        \"excerptLength\": 84\n      }\n    },\n    {\n      \"id\": \"weekly-divider\",\n      \"mode\": \"static\",\n      \"type\": \"section-divider\",\n      \"label\": \"The weekly news divider\",\n      \"file\": \"blocks/weekly-divider.hbs\",\n      \"order\": 3,\n      \"config\": {\n        \"scriptTitle\": \"The weekly news\",\n        \"sectionTitle\": \"本週重要事情佈達\"\n      }\n    },\n    {\n      \"id\": \"weekly-items\",\n      \"mode\": \"weekly-repeat\",\n      \"type\": \"weekly-summary-list\",\n      \"label\": \"Weekly announcements\",\n      \"file\": \"blocks/weekly-item.hbs\",\n      \"order\": 4,\n      \"articleSource\": \"weeklyItems\",\n      \"config\": {\n        \"sourceTag\": \"weekly\",\n        \"excerptLength\": 72,\n        \"readMoreLabel\": \"read more...\"\n      }\n    },\n    {\n      \"id\": \"community-html\",\n      \"mode\": \"custom-html\",\n      \"type\": \"custom-html\",\n      \"label\": \"Community announcement\",\n      \"file\": \"blocks/custom-html.hbs\",\n      \"order\": 5,\n      \"htmlSlot\": \"communityAnnouncement\"\n    },\n    {\n      \"id\": \"read-more-cta\",\n      \"mode\": \"static\",\n      \"type\": \"custom-html\",\n      \"label\": \"Read online button\",\n      \"file\": \"blocks/read-more-cta.hbs\",\n      \"order\": 6,\n      \"config\": {\n        \"ctaLabel\": \"READ MORE\"\n      }\n    },\n    {\n      \"id\": \"about\",\n      \"mode\": \"static\",\n      \"type\": \"about\",\n      \"label\": \"About us / 認識 善美真\",\n      \"file\": \"blocks/about.hbs\",\n      \"order\": 7,\n      \"config\": {\n        \"aboutTitleEn\": \"About us\",\n        \"aboutTitleZh\": \"認識 善美真\",\n        \"aboutImageUrl\": \"\",\n        \"schoolMission\": \"取名「善美真」，就是希望培養人性的善、美、真，做為教育的核心價值，建立一個與大自然融合的學習平台，幫助成人和學童身心靈保持整體動態的平衡與健康，並持續不斷地成長。在學習各種知識和生活藝能的同時，豐富心靈美感。\",\n        \"aboutUrl\": \"\",\n        \"aboutCtaLabel\": \"READ MORE\"\n      }\n    },\n    {\n      \"id\": \"footer\",\n      \"mode\": \"static\",\n      \"type\": \"footer\",\n      \"label\": \"Contact footer\",\n      \"file\": \"blocks/footer.hbs\",\n      \"order\": 8,\n      \"config\": {\n        \"schoolName\": \"善美真華德福實驗教育機構\",\n        \"tel\": \"04-26263111\",\n        \"fax\": \"04-26283830\",\n        \"address\": \"436 臺中市清水區公正路 52 號\",\n        \"facebookUrl\": \"https://www.facebook.com/smzwaldorf\",\n        \"facebookLabel\": \"Facebook 粉絲專頁\",\n        \"instagramUrl\": \"\",\n        \"contactEmail\": \"\",\n        \"websiteUrl\": \"\"\n      }\n    }\n  ]\n}\n",
