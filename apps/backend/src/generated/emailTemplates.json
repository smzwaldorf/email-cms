  "/templates/email/smz-school-news/partials/cta-button.hbs": "<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"{{#if align}}{{align}}{{else}}center{{/if}}\">\n  <tr>\n    <td align=\"center\" style=\"background-color:#f3bcc2;background-image:linear-gradient(180deg,#f8c8cc 0%,#efb2b9 100%);border-radius:14px;\">\n      <a href=\"{{url}}\" style=\"display:inline-block;min-width:130px;padding:10px 34px;color:#ffffff;font-family:Arial,Helvetica,'Noto Sans TC','PingFang TC',sans-serif;font-size:12px;line-height:1.4;font-weight:700;letter-spacing:3px;text-align:center;text-decoration:none;text-transform:uppercase;\">{{label}}</a>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smz-school-news/subject.hbs": "SMZ School News｜{{newsletter.title}}",
  "/templates/email/smzwaldorf-weekly/blocks/class-article.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f2f6ee;border-left:5px solid #789262;margin:18px 0;\">\n  <tr>\n    <td style=\"padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#25301f;\">\n      <div style=\"font-size:12px;text-transform:uppercase;letter-spacing:0.12em;color:#5d754c;\">{{eyebrow}} - {{class.name}}</div>\n      <h3 style=\"margin:8px 0 10px;font-size:19px;line-height:1.3;color:#25301f;\">{{article.title}}</h3>\n      <p style=\"margin:0 0 16px;font-size:15px;line-height:1.6;color:#4f5d46;\">{{article.excerpt}}</p>\n      {{> ctaButton url=article.url label=ctaLabel}}\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/blocks/custom-html.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:20px 0;background:#fff7ed;\">\n  <tr>\n    <td style=\"padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#3c2a1f;\">\n      {{{html.communityAnnouncement}}}\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/blocks/footer.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#3c2a1f;color:#f7ead7;margin-top:24px;\">\n  <tr>\n    <td style=\"padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;line-height:1.7;\">\n      <div>{{brandName}}</div>\n      <div>TEL: {{tel}} - FAX: {{fax}}</div>\n      <div>{{address}}</div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/blocks/header.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f7ead7;\">\n  <tr>\n    <td style=\"padding:28px 24px;text-align:center;font-family:Georgia,'Times New Roman',serif;color:#5a3f2b;\">\n      <div style=\"font-size:28px;font-weight:700;\">{{brandName}}</div>\n      <div style=\"margin-top:8px;font-size:15px;letter-spacing:0.04em;\">{{tagline}}</div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/blocks/shared-article.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#fffaf2;border:1px solid #ead8bf;margin:18px 0;\">\n  <tr>\n    <td style=\"padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#2f241d;\">\n      <div style=\"font-size:12px;text-transform:uppercase;letter-spacing:0.12em;color:#8b5a3c;\">{{eyebrow}}</div>\n      <h3 style=\"margin:8px 0 10px;font-size:21px;line-height:1.3;color:#3c2a1f;\">{{article.title}}</h3>\n      <p style=\"margin:0 0 16px;font-size:15px;line-height:1.6;color:#5c5149;\">{{article.excerpt}}</p>\n      {{> ctaButton url=article.url label=ctaLabel}}\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/blocks/weekly-item.hbs": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:12px 0;\">\n  <tr>\n    <td style=\"padding:14px 18px;background:#f8f4ea;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#3c2f24;\">\n      {{> sectionTitle title=sectionTitle}}\n      <div style=\"font-size:15px;line-height:1.6;\">\n        <a href=\"{{article.url}}\" style=\"color:#8b5a3c;text-decoration:none;font-weight:600;\">{{article.title}}</a>\n        <span style=\"color:#67594e;\"> - {{article.excerpt}}</span>\n      </div>\n    </td>\n  </tr>\n</table>\n",
  "/templates/email/smzwaldorf-weekly/metadata.json": "{\n  \"sourceId\": \"smzwaldorf-weekly\",\n  \"name\": \"SMZ Waldorf Weekly\",\n  \"description\": \"Bundled filesystem-authored newsletter template for admin preview and sync.\",\n  \"version\": \"1.0.0\",\n  \"subject\": \"subject.hbs\",\n  \"partials\": [\n    {\n      \"name\": \"ctaButton\",\n      \"file\": \"partials/cta-button.hbs\"\n    },\n    {\n      \"name\": \"sectionTitle\",\n      \"file\": \"partials/section-title.hbs\"\n    }\n  ],\n  \"blocks\": [\n    {\n      \"id\": \"header\",\n      \"mode\": \"static\",\n      \"type\": \"header\",\n      \"label\": \"Header\",\n      \"file\": \"blocks/header.hbs\",\n      \"order\": 0,\n      \"config\": {\n        \"brandName\": \"善美真華德福教育\",\n        \"tagline\": \"Weekly community notes\"\n      }\n    },\n    {\n      \"id\": \"featured-shared-articles\",\n      \"mode\": \"article-repeat\",\n      \"type\": \"shared-article-feature\",\n      \"label\": \"Featured shared articles\",\n      \"file\": \"blocks/shared-article.hbs\",\n      \"order\": 1,\n      \"articleSource\": \"sharedArticles\",\n      \"config\": {\n        \"eyebrow\": \"School News\",\n        \"ctaLabel\": \"Read the story\",\n        \"maxItems\": 3,\n        \"excerptLength\": 220\n      }\n    },\n    {\n      \"id\": \"class-news\",\n      \"mode\": \"class-article-repeat\",\n      \"type\": \"class-article-feature\",\n      \"label\": \"Class news\",\n      \"file\": \"blocks/class-article.hbs\",\n      \"order\": 2,\n      \"config\": {\n        \"eyebrow\": \"Class Notes\",\n        \"ctaLabel\": \"Open class article\",\n        \"maxItemsPerClass\": 2,\n        \"excerptLength\": 180\n      }\n    },\n    {\n      \"id\": \"weekly-items\",\n      \"mode\": \"weekly-repeat\",\n      \"type\": \"weekly-summary-list\",\n      \"label\": \"Weekly reminders\",\n      \"file\": \"blocks/weekly-item.hbs\",\n      \"order\": 3,\n      \"articleSource\": \"weeklyItems\",\n      \"config\": {\n        \"sectionTitle\": \"This Week\",\n        \"sourceTag\": \"weekly\",\n        \"excerptLength\": 120\n      }\n    },\n    {\n      \"id\": \"community-html\",\n      \"mode\": \"custom-html\",\n      \"type\": \"custom-html\",\n      \"label\": \"Community announcement\",\n      \"file\": \"blocks/custom-html.hbs\",\n      \"order\": 4,\n      \"htmlSlot\": \"communityAnnouncement\"\n    },\n    {\n      \"id\": \"footer\",\n      \"mode\": \"static\",\n      \"type\": \"footer\",\n      \"label\": \"Footer\",\n      \"file\": \"blocks/footer.hbs\",\n      \"order\": 5,\n      \"config\": {\n        \"tel\": \"+886-2-0000-0000\",\n        \"fax\": \"+886-2-0000-0001\",\n        \"address\": \"善美真華德福教育園區\"\n      }\n    }\n  ]\n}\n",
  "/templates/email/smzwaldorf-weekly/partials/cta-button.hbs": "<a href=\"{{url}}\" style=\"display:inline-block;padding:10px 16px;background:#8b5a3c;color:#ffffff;text-decoration:none;border-radius:999px;font-size:14px;font-weight:600;\">{{label}}</a>\n",
  "/templates/email/smzwaldorf-weekly/partials/section-title.hbs": "<h2 style=\"margin:0 0 12px;font-family:Georgia,'Times New Roman',serif;font-size:22px;line-height:1.25;color:#5a3f2b;\">{{title}}</h2>\n",
  "/templates/email/smzwaldorf-weekly/subject.hbs": "SMZ Waldorf Weekly - {{newsletter.title}}\n"
}
