<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;background-image:linear-gradient(180deg,#fdf5f1 0%,#ffffff 22%,#ffffff 78%,#fdf5f1 100%);">
  <tr>
    <td style="padding:22px 36px 26px;font-size:0;line-height:0;text-align:left;">
      <!-- Fluid columns: side by side on desktop, stacked on narrow screens -->
      <div style="display:inline-block;width:100%;max-width:232px;vertical-align:middle;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="padding:0 22px 12px 0;">
              <img src="{{article.image_url}}" width="210" alt="{{article.title}}" style="display:block;width:100%;max-width:210px;height:auto;border:0;border-radius:18px;background-color:#f1ddd2;" />
            </td>
          </tr>
        </table>
      </div>
      <div style="display:inline-block;width:100%;max-width:336px;vertical-align:middle;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="padding:0 0 12px;">
              <h2 style="margin:0;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:24px;line-height:1.3;font-weight:700;letter-spacing:2px;color:#4a4039;">{{article.title}}</h2>
              <div style="margin-top:4px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:1px;text-transform:uppercase;color:#9a8a7f;">{{eyebrow}} · {{class.name}}</div>
              <div style="margin-top:8px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;">{{article.excerpt}}</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;">
                <tr>
                  <td align="right" style="text-align:right;">
                    {{> ctaButton url=article.url label=ctaLabel align="right"}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
</table>
