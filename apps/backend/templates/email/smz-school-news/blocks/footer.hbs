<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
  <tr>
    <td style="padding:6px 36px 0;font-size:0;line-height:0;">
      <!-- Rainbow dashed rule sliced from the design -->
      <img src="{{> assetRule}}" width="568" height="16" alt="" style="display:block;width:100%;max-width:568px;height:auto;border:0;" />
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:22px 36px 0;text-align:center;">
      <div style="font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:19px;line-height:1.3;font-weight:700;letter-spacing:3px;color:#4a4039;">{{schoolName}}</div>
      <div style="margin-top:12px;font-family:Arial,Helvetica,'Noto Sans TC','PingFang TC',sans-serif;font-size:14px;line-height:1.6;letter-spacing:1px;color:#b89467;"><span style="display:inline-block;padding:0 12px;white-space:nowrap;">TEL : {{tel}}</span><span style="display:inline-block;padding:0 12px;white-space:nowrap;">FAX : {{fax}}</span></div>
      <div style="margin-top:4px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;letter-spacing:1px;color:#b89467;">地址：{{address}}</div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:18px 36px 34px;text-align:center;">
      <!-- Social icons sliced from the design; each renders only when its destination is configured -->
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
        <tr>
          {{#if facebookUrl}}
          <td style="padding:0 14px;">
            <a href="{{facebookUrl}}" title="{{facebookLabel}}" style="display:block;text-decoration:none;"><img src="{{> assetIconFacebook}}" width="44" height="44" alt="Facebook" style="display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;" /></a>
          </td>
          {{/if}}
          {{#if instagramUrl}}
          <td style="padding:0 14px;">
            <a href="{{instagramUrl}}" title="Instagram" style="display:block;text-decoration:none;"><img src="{{> assetIconInstagram}}" width="44" height="44" alt="Instagram" style="display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;" /></a>
          </td>
          {{/if}}
          {{#if contactEmail}}
          <td style="padding:0 14px;">
            <a href="mailto:{{contactEmail}}" title="{{contactEmail}}" style="display:block;text-decoration:none;"><img src="{{> assetIconEmail}}" width="44" height="44" alt="Email" style="display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;" /></a>
          </td>
          {{/if}}
          {{#if websiteUrl}}
          <td style="padding:0 14px;">
            <a href="{{websiteUrl}}" title="{{websiteUrl}}" style="display:block;text-decoration:none;"><img src="{{> assetIconWebsite}}" width="44" height="44" alt="Website" style="display:block;width:44px;height:44px;border:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#c39f70;" /></a>
          </td>
          {{/if}}
        </tr>
      </table>
    </td>
  </tr>
</table>
