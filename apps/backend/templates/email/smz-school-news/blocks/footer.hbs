<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7ede2;">
  <tr>
    <td style="padding:0;font-size:0;line-height:0;">
      <div style="height:4px;background:linear-gradient(90deg,#f7c39c,#f9d5d2,#dfe8f4,#f9d5d2,#f7c39c);background-color:#f9d5d2;"></div>
    </td>
  </tr>
  <tr>
    <td style="padding:28px 32px 12px;text-align:center;">
      <div style="font-family:'Snell Roundhand','Brush Script MT','Segoe Script',Georgia,serif;font-style:italic;font-size:22px;color:#ef9fb0;">{{aboutTitleEn}}</div>
      <div style="margin-top:4px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,sans-serif;font-size:18px;font-weight:700;color:#72564a;">{{aboutTitleZh}}</div>
      <div style="margin-top:12px;font-family:'Noto Sans TC','PingFang TC',Arial,sans-serif;font-size:13px;line-height:1.9;color:#8a7663;">{{schoolMission}}</div>
    </td>
  </tr>
  <tr>
    <td style="padding:8px 32px 30px;text-align:center;border-top:1px solid #eddfce;">
      <div style="margin-top:16px;font-family:'Noto Sans TC','PingFang TC',Arial,sans-serif;font-size:15px;font-weight:700;color:#72564a;">{{schoolName}}</div>
      <div style="margin-top:6px;font-family:Arial,'Noto Sans TC',sans-serif;font-size:12px;line-height:1.9;color:#a08a72;">TEL：{{tel}}&nbsp;&nbsp;|&nbsp;&nbsp;FAX：{{fax}}<br />地址：{{address}}</div>
      <div style="margin-top:14px;">
        <a href="{{facebookUrl}}" style="font-family:Arial,'Noto Sans TC',sans-serif;font-size:12px;color:#ef9fb0;text-decoration:underline;">{{facebookLabel}}</a>
      </div>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-size:0;line-height:0;">
      <div style="height:5px;background:linear-gradient(90deg,#e8a3b1,#f2c4ce,#f7c39c,#f2c4ce,#e8a3b1);background-color:#f2c4ce;"></div>
    </td>
  </tr>
</table>
