<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
  <tr>
    <td style="padding:0;font-size:0;line-height:0;">
      <!-- Masthead sliced from the design: watercolor logo, hand-lettered brand name and "SMZ School News" script -->
      <img src="{{> assetHeaderBanner}}" width="640" height="168" alt="{{brandName}} — {{scriptTitle}}" style="display:block;width:100%;max-width:640px;height:auto;border:0;font-family:'Snell Roundhand','Brush Script MT','Segoe Script',cursive;font-size:32px;line-height:168px;text-align:center;color:#e0a3b1;" />
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-size:0;line-height:0;">
      <div style="height:20px;background-color:#f9ece6;background-image:linear-gradient(180deg,#ffffff 0%,#f6e2d9 100%);">&nbsp;</div>
    </td>
  </tr>
</table>
