<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
  <tr>
    <td style="padding:30px 36px 20px;font-size:0;line-height:0;text-align:left;">
      <!-- Fluid columns: brand mark left, script title right; stacked on narrow screens -->
      <div style="display:inline-block;width:100%;max-width:160px;vertical-align:middle;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="center" style="text-align:center;">
              {{#if logoUrl}}
              <img src="{{logoUrl}}" width="88" height="88" alt="{{brandName}}" style="display:block;margin:0 auto;width:88px;height:88px;border:0;" />
              {{else}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
                <tr>
                  <td width="88" height="88" align="center" valign="middle" style="width:88px;height:88px;border-radius:50%;background-color:#f3dbe3;background-image:radial-gradient(circle at 62% 38%,rgba(255,243,196,0.95) 0,rgba(255,243,196,0.9) 9px,rgba(255,243,196,0) 20px),radial-gradient(circle at 42% 56%,rgba(233,178,200,0.95) 0,rgba(233,178,200,0.8) 18px,rgba(233,178,200,0) 34px),radial-gradient(circle at 60% 46%,rgba(166,200,233,0.9) 0,rgba(166,200,233,0.7) 26px,rgba(166,200,233,0) 46px),linear-gradient(135deg,#fbebe6 0%,#eef4fb 100%);">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="22" height="22" style="width:22px;height:22px;border-radius:50%;background-color:#f6d77a;font-size:0;line-height:0;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
              {{/if}}
              <div style="margin-top:10px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:2px;color:#d08d9e;white-space:nowrap;">{{brandName}}</div>
            </td>
          </tr>
        </table>
      </div>
      <div style="display:inline-block;width:100%;max-width:408px;vertical-align:middle;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="right" style="padding:10px 0 0;text-align:right;">
              <div style="font-family:'Snell Roundhand','Brush Script MT','Segoe Script','Savoye LET',cursive;font-size:44px;line-height:1.1;color:#e0a3b1;">{{scriptTitle}}</div>
            </td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
  <tr>
    <td style="padding:0;font-size:0;line-height:0;">
      <div style="height:18px;background-color:#f8ebe4;background-image:linear-gradient(180deg,#ffffff 0%,#f6e2d9 100%);">&nbsp;</div>
    </td>
  </tr>
</table>
