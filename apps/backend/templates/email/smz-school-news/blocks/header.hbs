<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf1e7;">
  <tr>
    <td style="padding:30px 32px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="42%" valign="middle" style="text-align:left;">
            <div style="font-size:17px;line-height:1;letter-spacing:3px;">
              <span style="color:#f2a0ad;">&#9679;</span><span style="color:#f7c39c;">&#9679;</span><span style="color:#f2d478;">&#9679;</span><span style="color:#b5cf9f;">&#9679;</span><span style="color:#a9c6e8;">&#9679;</span><span style="color:#c9aede;">&#9679;</span>
            </div>
            <div style="margin-top:10px;font-family:Arial,'Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif;font-size:13px;letter-spacing:3px;color:#a8765a;font-weight:700;white-space:nowrap;">{{brandName}}</div>
          </td>
          <td valign="middle" style="text-align:right;">
            <div style="font-family:'Snell Roundhand','Brush Script MT','Segoe Script',Georgia,serif;font-style:italic;font-size:46px;line-height:1.15;color:#ef9fb0;">{{scriptTitle}}</div>
            <div style="margin-top:6px;font-family:Arial,'Noto Sans TC','PingFang TC',sans-serif;font-size:11px;letter-spacing:2px;color:#c2a58c;">{{tagline}}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="font-size:0;line-height:0;">
      <div style="height:4px;background:linear-gradient(90deg,#fbddc7,#f9d5d2,#fdf0e8,#f9d5d2,#fbddc7);background-color:#f9d5d2;"></div>
    </td>
  </tr>
</table>
