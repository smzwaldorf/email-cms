<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf8f4;background-image:repeating-linear-gradient(0deg,rgba(243,231,215,0) 0,rgba(243,231,215,0) 23px,#f1e4d6 23px,#f1e4d6 24px),repeating-linear-gradient(90deg,rgba(243,231,215,0) 0,rgba(243,231,215,0) 23px,#f1e4d6 23px,#f1e4d6 24px);">
  <tr>
    <td align="right" style="padding:34px 0 0 36px;text-align:right;">
      <span style="display:inline-block;padding:14px 40px 10px 34px;background-color:#d9e9f9;background-image:linear-gradient(90deg,#eaf3fc 0%,#cfe3f6 100%);border-radius:22px 0 0 8px;font-family:'Snell Roundhand','Brush Script MT','Segoe Script','Savoye LET',cursive;font-size:36px;line-height:1.1;color:#9c7c65;">{{scriptTitle}}</span>
    </td>
  </tr>
  <tr>
    <td style="padding:0 36px 18px 0;">
      <span style="display:inline-block;padding:12px 44px 12px 36px;background-color:#e59aa6;background-image:linear-gradient(90deg,#e3919e 0%,#e8a8b2 100%);border-radius:0 30px 26px 0;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:20px;line-height:1.3;font-weight:700;letter-spacing:3px;color:#ffffff;">{{sectionTitle}}</span>
    </td>
  </tr>
</table>
