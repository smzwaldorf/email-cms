<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf6ee;background-image:repeating-linear-gradient(0deg,transparent,transparent 23px,#f3e7d7 24px),repeating-linear-gradient(90deg,transparent,transparent 23px,#f3e7d7 24px);">
  <tr>
    <td style="padding:34px 32px 4px;text-align:right;">
      <span style="display:inline-block;padding:10px 26px;background-color:#cfe0f2;border-radius:22px 6px 22px 6px;font-family:'Snell Roundhand','Brush Script MT','Segoe Script',Georgia,serif;font-style:italic;font-size:30px;line-height:1.2;color:#5b7ba6;">{{scriptTitle}}</span>
    </td>
  </tr>
  <tr>
    <td style="padding:6px 32px 12px;text-align:left;">
      <span style="display:inline-block;padding:14px 38px 14px 24px;background-color:#f29fae;border-radius:10px 30px 30px 10px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,sans-serif;font-size:21px;font-weight:700;color:#ffffff;letter-spacing:2px;">{{sectionTitle}}</span>
    </td>
  </tr>
</table>
