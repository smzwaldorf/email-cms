<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf6ee;background-image:repeating-linear-gradient(0deg,transparent,transparent 23px,#f3e7d7 24px),repeating-linear-gradient(90deg,transparent,transparent 23px,#f3e7d7 24px);">
  <tr>
    <td style="padding:10px 32px 6px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="20" valign="top" style="width:20px;padding-top:2px;">
            <span style="color:#f29fae;font-size:14px;line-height:1;">&#9679;</span>
          </td>
          <td valign="top">
            <a href="{{article.url}}" style="font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,sans-serif;font-size:16px;font-weight:700;color:#574a42;text-decoration:none;">{{article.title}}</a>
            <div style="margin-top:3px;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:11px;letter-spacing:1px;color:#b3a89f;">{{article.date}}</div>
            <div style="margin-top:5px;font-family:'Noto Sans TC','PingFang TC',Arial,sans-serif;font-size:13px;line-height:1.8;color:#857a71;">{{article.excerpt}} <a href="{{article.url}}" style="color:#ef9fb0;text-decoration:none;font-weight:600;">{{readMoreLabel}}</a></div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
