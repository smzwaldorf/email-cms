<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
  <tr>
    <td style="padding:10px 36px 8px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="112" valign="top" style="width:112px;padding-right:14px;">
            <img src="{{article.image_url}}" width="98" alt="{{article.title}}" style="display:block;width:98px;height:72px;object-fit:cover;border:0;border-radius:12px;background-color:#f1ddd2;" />
          </td>
          <td width="18" valign="top" style="width:18px;padding-top:7px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="9" height="9" style="width:9px;height:9px;border-radius:50%;background-color:#df97a7;font-size:0;line-height:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
          <td valign="top" style="padding-left:6px;">
            <a href="{{article.url}}" style="font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:16px;line-height:1.35;font-weight:700;color:#4a4039;text-decoration:underline;">{{article.title}}</a>
            <div style="margin-top:3px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.4;letter-spacing:0.5px;color:#b9a48f;">{{article.date}}</div>
            <div style="margin-top:6px;font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.85;color:#6e6057;">{{article.excerpt}} <a href="{{article.url}}" style="color:#6e6057;text-decoration:none;">{{readMoreLabel}}</a></div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
