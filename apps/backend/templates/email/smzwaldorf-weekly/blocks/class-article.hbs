<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f2f6ee;border-left:5px solid #789262;margin:18px 0;">
  <tr>
    <td style="padding:20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#25301f;">
      <div style="font-size:12px;text-transform:uppercase;letter-spacing:0.12em;color:#5d754c;">{{eyebrow}} - {{class.name}}</div>
      <h3 style="margin:8px 0 10px;font-size:19px;line-height:1.3;color:#25301f;">{{article.title}}</h3>
      <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4f5d46;">{{article.excerpt}}</p>
      {{> ctaButton url=article.url label=ctaLabel}}
    </td>
  </tr>
</table>
