<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fffaf2;border:1px solid #ead8bf;margin:18px 0;">
  <tr>
    <td style="padding:22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#2f241d;">
      <div style="font-size:12px;text-transform:uppercase;letter-spacing:0.12em;color:#8b5a3c;">{{eyebrow}}</div>
      <h3 style="margin:8px 0 10px;font-size:21px;line-height:1.3;color:#3c2a1f;">{{article.title}}</h3>
      <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#5c5149;">{{article.excerpt}}</p>
      {{> ctaButton url=article.url label=ctaLabel}}
    </td>
  </tr>
</table>
