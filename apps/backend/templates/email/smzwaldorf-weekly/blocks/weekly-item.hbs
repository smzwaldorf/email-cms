<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:12px 0;">
  <tr>
    <td style="padding:14px 18px;background:#f8f4ea;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#3c2f24;">
      {{> sectionTitle title=sectionTitle}}
      <div style="font-size:15px;line-height:1.6;">
        <a href="{{article.url}}" style="color:#8b5a3c;text-decoration:none;font-weight:600;">{{article.title}}</a>
        <span style="color:#67594e;"> - {{article.excerpt}}</span>
      </div>
    </td>
  </tr>
</table>
