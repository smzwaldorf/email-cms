{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "#/*": ["src/*"],
      "#shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/routes.ts",
    "src/auth.ts",
    "src/config.ts",
    "src/lib/**/*.ts",
    "src/worker/**/*.ts"
  ],
  "exclude": ["dist", "tests", "**/*.test.ts", "**/*.test.tsx"]
}
