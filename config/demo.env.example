# Private values belong in ignored env files or deployment secrets, never here.
# Use two NEW controlled inboxes; offline placeholders must not receive real mail.
DEMO_PARENT_A_EMAIL=parent-a@example.invalid
DEMO_PARENT_B_EMAIL=parent-b@example.invalid
# Each repository uses its own DATABASE_URL. Confirmation excludes port/credentials.
DEMO_DATABASE_CONFIRM=database-host/database-name
# Explicit operator opt-in for the initial CMS fixture; reruns never change consent.
DEMO_SUBSCRIPTIONS_CONFIRMED=false
# CMS API and delivery worker settings for the hosted demo.
NEWSLETTER_DEMO_MODE=true
NEWSLETTER_TEST_RECIPIENTS=parent-a@example.invalid,parent-b@example.invalid
DELIVERY_ENABLED=false
CMS_SESSION_ENABLED=true
VITE_CMS_SERVER_SESSION=true
# RESEND_API_KEY and RESEND_FROM_EMAIL use the existing verified sender.
# Real issuer, exact app origin, CMS session secret and OIDC client secret required.
# Hosted Auth: NODE_ENV=production and ENABLE_DEV_LOGIN=false.
