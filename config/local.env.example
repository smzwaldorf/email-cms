# Supply an existing local CMS PostgreSQL connection; do not reset data.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55440/email_cms
SMZ_AUTH_ISSUER=http://localhost:3000/api/auth
VITE_SMZ_AUTH_ISSUER=http://localhost:3000/api/auth
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8787
BACKEND_CORS_ORIGIN=http://localhost:5173
PORT=8787
DELIVERY_ENABLED=false
# Real provider credentials are intentionally absent. Mocked tests need none.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# NEWSLETTER_TEST_RECIPIENTS=

# Local compatibility mode. See specs/docs/RUNTIME-ENVIRONMENTS.md for server-session parity.
CMS_SESSION_ENABLED=false
VITE_CMS_SERVER_SESSION=false
# CMS_SESSION_SECRET=
# CMS_OIDC_CLIENT_SECRET=

# Signing secret from the Resend webhook endpoint (not the sending API key).
# RESEND_WEBHOOK_SECRET=whsec_...

# Private Cloudflare R2 development binding (same physical bucket as staging,
# separate development/ object prefix). Requires R2 activation and school-account Wrangler login.
MEDIA_STORAGE_ENVIRONMENT=development
MEDIA_R2_BUCKET=smz-cms-media-dev-staging
MEDIA_API_ORIGIN=http://localhost:8787
VITE_STORAGE_PROVIDER=r2
# Supply a private random secret (at least 32 characters). JWT_SECRET may be reused.
# MEDIA_SIGNING_SECRET=

# Permanent email assets use staging-media.smzwaldorf.com (production: media.smzwaldorf.com).
# The cloud Worker must have the matching media records in its database; local-only records are not reachable.

# PDF import and AI narration (backend only)
# OPENAI_API_KEY=
OPENAI_PDF_MODEL=gpt-4.1-mini
