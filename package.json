{
  "name": "email-cms-newsletter-viewer",
  "version": "1.0.0",
  "description": "電子報閱讀 CMS Web App - 允許讀者查看和瀏覽每週電子報內容",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @email-cms/frontend",
    "frontend:dev": "npm run dev -w @email-cms/frontend",
    "backend:dev": "npm run dev -w @email-cms/backend",
    "worker:dev": "npm run worker -w @email-cms/backend",
    "build": "npm run build -w @email-cms/shared && npm run build -w @email-cms/backend && npm run build -w @email-cms/frontend",
    "frontend:build": "npm run build -w @email-cms/frontend",
    "server:build": "npm run build -w @email-cms/backend",
    "backend:build": "npm run build -w @email-cms/backend",
    "preview": "npm run preview -w @email-cms/frontend",
    "test": "npm run test -w @email-cms/frontend && npm run test -w @email-cms/backend",
    "test:ui": "npm run test:ui -w @email-cms/frontend",
    "coverage": "npm run coverage -w @email-cms/frontend",
    "lint": "eslint apps/frontend/src apps/frontend/tests apps/backend/src packages/shared/src --ext .ts,.tsx",
    "format": "prettier --write \"apps/frontend/src/**/*.{ts,tsx,css}\" \"apps/frontend/tests/**/*.{ts,tsx}\" \"apps/backend/src/**/*.ts\" \"packages/shared/src/**/*.ts\"",
    "seed": "npm run seed:demo",
    "db:up": "docker compose up -d postgres",
    "db:schema": "bash db/apply-schema.sh",
    "db:copy-data": "bash db/copy-data.sh",
    "cloudflare:templates": "node scripts/cloudflare-templates.mjs",
    "cloudflare:configure": "node scripts/cloudflare-config.mjs",
    "cloudflare:pages:build": "node scripts/cloudflare-pages.mjs",
    "cloudflare:email-assets": "node scripts/email-assets-deploy.mjs",
    "cloudflare:schema": "node scripts/cloudflare-schema.mjs",
    "cloudflare:check": "npm run cloudflare:templates && npm run cloudflare:typecheck && wrangler deploy --dry-run --config apps/backend/wrangler.jsonc",
    "cloudflare:typecheck": "tsc -p apps/backend/tsconfig.cloudflare.json",
    "db:types": "node scripts/generate-sql-types.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:weekly-articles": "node scripts/add-demo-weekly-articles.mjs",
    "test:seed": "node --test scripts/demo-seed.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@tiptap/extension-blockquote": "^3.12.0",
    "@tiptap/extension-code-block": "^3.12.0",
    "@tiptap/extension-color": "^3.12.0",
    "@tiptap/extension-highlight": "^3.12.0",
    "@tiptap/extension-horizontal-rule": "^3.12.0",
    "@tiptap/extension-image": "^3.12.0",
    "@tiptap/extension-link": "^3.12.0",
    "@tiptap/extension-placeholder": "^3.12.0",
    "@tiptap/extension-subscript": "^3.12.0",
    "@tiptap/extension-superscript": "^3.12.0",
    "@tiptap/extension-table": "^3.12.0",
    "@tiptap/extension-task-item": "^3.12.0",
    "@tiptap/extension-task-list": "^3.12.0",
    "@tiptap/extension-text-align": "^3.12.0",
    "@tiptap/extension-text-style": "^3.12.0",
    "@tiptap/extension-youtube": "^3.12.0",
    "@tiptap/pm": "^3.12.0",
    "@tiptap/react": "^3.12.0",
    "@tiptap/starter-kit": "^3.12.0",
    "@types/uuid": "^10.0.0",
    "@uiw/react-md-editor": "^4.0.8",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.25",
    "handlebars": "^4.7.9",
    "jose": "^6.1.3",
    "jsdom": "^23.0.0",
    "linkedom": "0.18.12",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.555.0",
    "oidc-client-ts": "^3.5.0",
    "openid-client": "^6.7.1",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-window": "^2.2.3",
    "recharts": "^3.5.1",
    "rehype-sanitize": "^5.0.1",
    "remark": "^15.0.0",
    "remark-html": "^15.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.0",
    "terser": "^5.44.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "4.131.0"
  }
}
